{
  "name": "refund-app",
  "private": true,
  "workspaces": [
    "apps/backend",
    "apps/frontend"
  ],
  "scripts": {
    "prepare": "husky",
    "dev:backend": "npm run dev --workspace refund-api",
    "dev:frontend": "npm run dev --workspace refund-web",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "test:api": "npm run test --workspace refund-api",
    "test:e2e": "npm run test:e2e --workspace refund-web"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4"
  },
  "lint-staged": {
    "apps/backend/**/*.{ts,tsx}": [
      "npm run lint:fix --workspace refund-api",
      "npm run format --workspace refund-api"
    ],
    "apps/frontend/**/*.{ts,tsx}": [
      "npm run lint:fix --workspace refund-web",
      "npm run format --workspace refund-web"
    ]
  },
  "dependencies": {
    "axios": "^1.19.0",
    "clsx": "^2.1.1",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "@prisma/engines@7.9.0": true,
    "bcrypt@6.0.0": true,
    "esbuild@0.28.1": true,
    "prisma@7.9.0": true
  }
}
