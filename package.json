{
  "name": "refund-app",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "prepare": "husky",
    "dev:backend": "npm run dev --workspace refund-api",
    "dev:frontend": "npm run dev --workspace refund-web"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8"
  },
  "lint-staged": {
    "backend/**/*.{ts,tsx}": [
      "npm run lint:fix --workspace backend",
      "npm run format --workspace backend"
    ],
    "frontend/**/*.{ts,tsx}": [
      "npm run lint:fix --workspace frontend",
      "npm run format --workspace frontend"
    ]
  }
}
