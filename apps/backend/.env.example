# Local development (copy to `.env` in this folder)
DATABASE_URL="postgresql://refund:refund@localhost:5432/refund"
JWT_SECRET="change-me-to-a-long-random-secret"
PORT=3333

# Requires Postgres running (e.g. `npm run docker:up` or `docker compose up postgres`).
# API tests use `refund_test` (created by docker/postgres/init.sql on first Compose start).
# Docker Compose sets DATABASE_URL, JWT_SECRET, and PORT automatically.
